APP_NAME=FinLab
APP_ENV=development
API_V1_PREFIX=/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

DATABASE_URL=postgresql+psycopg2://finlab:finlab@localhost:5432/finlab

MOEX_BASE_URL=https://iss.moex.com/iss
MOEX_DEFAULT_ENGINE=stock
MOEX_DEFAULT_MARKET=shares
MOEX_DEFAULT_BOARD=TQBR
MOEX_TIMEOUT_SECONDS=15
MOEX_RETRY_ATTEMPTS=2
MOEX_RETRY_DELAY_SECONDS=0.5

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
